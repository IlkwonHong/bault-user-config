#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <dt-bindings/zmk/pointing.h>

/ {

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Homerow Mods";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <0>;
            flavor = "tap-preferred";
        };
    };



    /* 🔹 콤보 정의 */
    combos {
        compatible = "zmk,combos";

        // Q + W -> Tab (베이스 레이어에서만)
        combo_qw_tab {
            timeout-ms = <30>;              // 30~50ms 선호, 필요시 조절
            require-prior-idle-ms = <120>; 
            key-positions = <0 1>;          // Q=0, W=1
            bindings = <&kp TAB>;
            layers = <0>;                   // base 레이어에서만 동작 (원하면 삭제)
        };
        combo_ws_esc {
            timeout-ms = <30>;              // 30~50ms 선호, 필요시 조절
            require-prior-idle-ms = <120>; 
            key-positions = <1 2>;          // Q=0, W=1
            bindings = <&kp ESC>;
            layers = <0>;                   // base 레이어에서만 동작 (원하면 삭제)
        };

        // A + S -> Caps Lock
        combo_as_caps {
            timeout-ms = <30>;
            key-positions = <11 12>;        // A=11, S=12
            bindings = <&kp CAPSLOCK>;
            layers = <0>;
        };
    };
    /* 🔹 콤보 정의 */


    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BACKSPACE
                &hm LGUI A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_SHIFT F  &kp G      &kp H      &hm RIGHT_SHIFT J  &hm RIGHT_CONTROL K  &hm LEFT_ALT L  &hm RIGHT_GUI ENTER
                &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA      &kp PERIOD      &kp RIGHT_SHIFT
                &mo 3      &mo 3      &kp ENTER      &lt 2 SPACE      &lt 1 SPACE      &mo 1      &mo 2      &kp N0
            >;
        };


        layer_1 {
            bindings = <
                &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &kp HOME    &kp END    &kp LEFT_BRACKET     &kp RIGHT_BRACKET     &kp BACKSLASH
                &kp N4  &hm LEFT_ALT N5  &hm LEFT_CONTROL N6  &hm LEFT_SHIFT MINUS  &trans  &kp LEFT  &hm RIGHT_SHIFT DOWN    &hm RIGHT_CONTROL UP    &hm RIGHT_ALT RIGHT  &kp SEMICOLON
                &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans  &trans  &trans  &trans  &kp SLASH  &trans
                &trans   &trans  &trans  &trans  &trans  &trans    &trans &kp N0
            >;
        };


        layer_2 {
            bindings = <
                &kp F7  &kp F8  &kp F9  &kp F10  &trans  &bt BT_SEL 0  &mkp MB1  &mmv MOVE_UP  &mkp MB2  &bt BT_SEL 4  &kp GRAVE
                &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans        &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_RIGHT        &kp SINGLE_QUOTE
                &kp F1  &kp F2  &kp F3  &kp F12  &trans  &bt BT_CLR    &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &trans
                &kp N0   &trans  &trans  &trans  &trans        &trans        &trans &kp N0
            >;
        };

        layer_3 {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &kp F10  &trans  &bt BT_SEL 0  &mkp MB1  &mmv MOVE_UP  &mkp MB2  &bt BT_SEL 4  &bt BT_CLR
                &out OUT_TOG   &kp F5  &kp F6  &kp F11  &trans  &trans        &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_RIGHT        &kp SINGLE_QUOTE
                &out OUT_BLE  &out OUT_USB  &out OUT_USB   &kp F12  &trans  &bt BT_CLR    &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &trans
                &kp N0   &trans  &trans  &trans  &trans        &trans        &trans &soft_off
            >;
        };
    };
};
